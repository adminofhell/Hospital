{% extends 'partials/base.html.twig' %}

{% block content %}
	{{ page.content|raw }}
	<script>
	let slideIndex = 1;
		showSlides(slideIndex);

		// Next/previous controls
		function plusSlides(n) {
  			showSlides(slideIndex += n);
		}

		// Thumbnail image controls
		function currentSlide(n) {
  			showSlides(slideIndex = n);
		}
		function showSlides(n) {
  			let i;
  			let slides = document.getElementsByClassName("reviews-single");
  			let dots = document.getElementsByClassName("dot");
  			if (n > slides.length) {slideIndex = 1}
  			if (n < 1) {slideIndex = slides.length}
  			for (i = 0; i < slides.length; i++) {
    			slides[i].style.display = "none";
  			}
  			for (i = 0; i < dots.length; i++) {
    			dots[i].className = dots[i].className.replace(" active", "");
  			}
  			slides[slideIndex-1].style.display = "block";
  			dots[slideIndex-1].className += " active";
		}
		function movePhotos(n){
			let slides = document.getElementsByClassName("description-slide");
			let framesArray = [{opacity: 0.4}, {opacity: 1}];
			let timingArray = {duration: 1500, iterations: 1};
			for(let i=0; i<slides.length; i++){
				slides[i].style.order = (parseInt(slides[i].style.order) + n + slides.length) % slides.length;
				console.log("Slide: "+i+", order: "+slides[i].style.order);
			}
			for(let i=0; i<slides.length; i++){
				slides[i].animate(framesArray, timingArray);
			}
		}
	</script>
{% endblock %}